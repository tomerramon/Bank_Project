{
	"files": [],
	"references": [
		{
			"path": "./tsconfig.app.json"
		},
		{
			"path": "./tsconfig.node.json"
		}
	],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"@": ["src"], // Added this to match Vite's behavior
			"@components/*": ["src/components/*"],
			"@pages/*": ["src/pages/*"],
			"@hooks/*": ["src/hooks/*"],
			"@lib/*": ["src/lib/*"],
			"@styles/*": ["src/styles/*"],
			"@types/*": ["src/types/*"],
			"@store/*": ["src/store/*"],
			"@api/*": ["src/api/*"],
			"@assets/*": ["src/assets/*"]
		}
	}
}
